# DOCA from the Red Hat-hosted Partner Ecosystem Repository (PER), namespace
# @partner-repos-nvidia-doca, instead of the internal partner COPR.
# Packages and keys verified 2026-11-25: doca-openvswitch-3.5.0052-1.el10 and
# doca-openvswitch-ipsec-3.5.0052-1.el10 for both arches.
#
# The stanzas stay enabled=0 on purpose. This repository also carries
# libibverbs, rdma-core, opensm and mft, which would shadow the RHEL
# BaseOS/AppStream versions if it were enabled during an unrelated transaction.
# subscription-manager ignores repo priority, so isolation is explicit
# enablement per transaction (see the Containerfile).

[doca-x86_64]
name=NVIDIA DOCA (PER, x86_64)
baseurl=https://packages.redhat.com/api/pulp-content/partner-repositories/@partner-repos-nvidia-doca/ovs-doca-3.5/custom-1-$basearch/
enabled=0
gpgcheck=1
gpgkey=https://partner-repositories.redhat.com/keys/RPM-GPG-KEY-redhat-partner-nvidia-doca-2 https://partner-repositories.redhat.com/keys/RPM-GPG-KEY-redhat-partner-nvidia-doca-3pq

[doca-aarch64]
name=NVIDIA DOCA (PER, aarch64 / 64k)
baseurl=https://packages.redhat.com/api/pulp-content/partner-repositories/@partner-repos-nvidia-doca/ovs-doca-3.5/custom-1-$basearch/
enabled=0
gpgcheck=1
gpgkey=https://partner-repositories.redhat.com/keys/RPM-GPG-KEY-redhat-partner-nvidia-doca-2 https://partner-repositories.redhat.com/keys/RPM-GPG-KEY-redhat-partner-nvidia-doca-3pq

[rhel-10.2-supp-eus]
name=rhel-10.2-supp-eus
baseurl=https://rhsm-pulp.corp.redhat.com/content/eus/rhel10/10.2/$basearch/supplementary/os/
enabled=1
# Temporarily disable RPM signature
# See: https://github.com/coreos/rhel-coreos-config/issues/146#issuecomment-4245037009
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
includepkgs=mlnx*,chkconfig*
excludepkgs=doca*

[rhel-10.2-supp]
name=rhel-10.2-supp
baseurl=https://rhsm-pulp.corp.redhat.com/content/dist/rhel10/10.2/$basearch/supplementary/os/
enabled=1
# Temporarily disable RPM signature
# See: https://github.com/coreos/rhel-coreos-config/issues/146#issuecomment-4245037009
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
excludepkgs=doca*

[rhel-10.2-extensions]
name=rhel-10.2-extensions
baseurl=https://rhsm-pulp.corp.redhat.com/content/dist/rhel10/10.2/$basearch/extensions/os/
enabled=1
# Temporarily disable RPM signature
# See: https://github.com/coreos/rhel-coreos-config/issues/146#issuecomment-4245037009
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[codeready-builder-for-rhel-10]
name=codeready-builder-for-rhel-10
baseurl=https://rhsm-pulp.corp.redhat.com/content/dist/rhel10/10.2/$basearch/codeready-builder/os
enabled=1
# Temporarily disable RPM signature
# See: https://github.com/coreos/rhel-coreos-config/issues/146#issuecomment-4245037009
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[rhel-10.2-baseos]
name=rhel-10.2-baseos
baseurl=https://rhsm-pulp.corp.redhat.com/content/dist/rhel10/10.2/$basearch/baseos/os/
