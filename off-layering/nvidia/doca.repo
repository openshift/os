[doca-x86_64]
name=DOCA Online Repo x86_64
baseurl=https://linux.mellanox.com/public/repo/doca/3.3.0/rhel10/x86_64/
enabled=1
gpgcheck=0

[doca-aarch64]
name=DOCA Online Repo 64k
baseurl=https://linux.mellanox.com/public/repo/doca/3.3.0/rhel10/sbsa-arm64/
enabled=1
gpgcheck=0

[rhel-10.2-supp-eus]
name=rhel-10.2-supp-eus
baseurl=https://rhsm-pulp.corp.redhat.com/content/eus/rhel10/10.2/$basearch/supplementary/os/
enabled=1
# Temporarily disable RPM signature
# See: https://github.com/coreos/rhel-coreos-config/issues/146#issuecomment-4245037009
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
includepkgs=mlnx*,chkconfig*
excludepkgs=doca*

